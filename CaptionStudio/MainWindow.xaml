<Window
    x:Class="CaptionStudio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Caption Studio">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Loaded="OnLayoutLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="StudioTitleBar"
                  AutomationProperties.AutomationId="StudioTitleBar"
                  Title="Caption Studio">
            <TitleBar.IconSource>
                <FontIconSource Glyph="&#xE8BD;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </TitleBar.IconSource>
        </TitleBar>

        <Grid Grid.Row="1" Padding="16,8,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="8" Margin="0,0,0,12" SizeChanged="OnToolbarSizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button x:Name="CaptureButton"
                        AutomationProperties.AutomationId="CaptureButton"
                        MinWidth="88"
                        Click="OnCaptureClicked"
                        Content="取得開始"
                        Style="{StaticResource AccentButtonStyle}" />

                <StackPanel x:Name="TranscriptActions"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="8">
                    <Button x:Name="CopyButton"
                            AutomationProperties.AutomationId="CopyTranscriptButton"
                            Click="OnCopyClicked"
                            Content="全文コピー"
                            IsEnabled="False" />
                    <Button x:Name="SaveButton"
                            AutomationProperties.AutomationId="SaveTranscriptButton"
                            Click="OnSaveClicked"
                            Content="TXT に保存"
                            IsEnabled="False" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="48" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="16,12,16,4" Spacing="4">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock AutomationProperties.HeadingLevel="Level1"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Text="字幕" />
                            <TextBlock x:Name="StatusText"
                                       Grid.Column="1"
                                       AutomationProperties.AutomationId="CaptureStatus"
                                       AutomationProperties.LiveSetting="Polite"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                        </Grid>
                        <TextBlock x:Name="CaptureHint"
                                   AutomationProperties.AutomationId="CaptureHint"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                    </StackPanel>

                    <ScrollViewer x:Name="TranscriptScroll"
                                  Grid.Row="1"
                                  AutomationProperties.AutomationId="TranscriptScroll"
                                  AutomationProperties.Name="字幕のスクロール領域"
                                  HorizontalScrollMode="Disabled"
                                  IsTabStop="True"
                                  Padding="16,4,16,8"
                                  SizeChanged="OnTranscriptSizeChanged"
                                  VerticalScrollBarVisibility="Auto"
                                  ViewChanged="OnTranscriptViewChanged">
                        <TextBlock x:Name="TranscriptText"
                                   AutomationProperties.AutomationId="TranscriptText"
                                   FontSize="16"
                                   IsTextSelectionEnabled="True"
                                   LineHeight="26"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>

                    <StackPanel x:Name="EmptyTranscriptState"
                                Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Margin="16"
                                MaxWidth="340"
                                Spacing="8">
                        <FontIcon AutomationProperties.AccessibilityView="Raw"
                                  FontSize="22"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  Glyph="&#xE8BD;" />
                        <TextBlock AutomationProperties.AutomationId="EmptyTranscriptHint"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   LineHeight="24"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap">
                            <Run x:Name="EmptyTranscriptTitle" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <LineBreak />
                            <Run x:Name="EmptyTranscriptDetail" />
                        </TextBlock>
                    </StackPanel>

                    <Grid Grid.Row="2" ColumnSpacing="8" Margin="16,0,16,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="ActionFeedback"
                                   AutomationProperties.AutomationId="ActionFeedback"
                                   AutomationProperties.LiveSetting="Polite"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   MaxLines="2"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="Wrap" />

                        <Button x:Name="LatestButton"
                                Grid.Column="1"
                                AutomationProperties.AutomationId="LatestCaptionButton"
                                AutomationProperties.Name="最新へ"
                                VerticalAlignment="Center"
                                Click="OnLatestClicked"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon FontSize="12" Glyph="&#xE74B;" />
                                <TextBlock Text="最新へ" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <InfoBar x:Name="SaveFeedback"
                     Grid.Row="2"
                     AutomationProperties.AutomationId="SaveFeedback"
                     Severity="Error" />
        </Grid>
    </Grid>
</Window>
