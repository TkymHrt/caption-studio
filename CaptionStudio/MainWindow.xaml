<Window
    x:Class="CaptionStudio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Caption Studio">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="24" RowSpacing="12" Loaded="OnLayoutLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="StartButton"
                    AutomationProperties.AutomationId="StartCaptureButton"
                    Click="OnStartClicked"
                    Content="取得開始"
                    Style="{StaticResource AccentButtonStyle}" />
            <Button x:Name="StopButton"
                    AutomationProperties.AutomationId="StopCaptureButton"
                    Click="OnStopClicked"
                    Content="取得停止"
                    IsEnabled="False" />
            <Button x:Name="SaveButton"
                    AutomationProperties.AutomationId="SaveTranscriptButton"
                    Click="OnSaveClicked"
                    Content="TXT に保存"
                    IsEnabled="False" />
        </StackPanel>

        <TextBlock x:Name="StatusText"
                   Grid.Row="1"
                   AutomationProperties.AutomationId="CaptureStatus"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="Win + Ctrl + L でライブ キャプションを開き、取得を開始してください。"
                   TextWrapping="Wrap" />

        <Border Grid.Row="2"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <ScrollViewer x:Name="TranscriptScroll" Padding="12">
                <TextBlock x:Name="TranscriptText"
                           AutomationProperties.AutomationId="TranscriptText"
                           IsTextSelectionEnabled="True"
                           TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <InfoBar x:Name="SaveFeedback"
                 Grid.Row="3"
                 AutomationProperties.AutomationId="SaveFeedback" />
    </Grid>
</Window>
